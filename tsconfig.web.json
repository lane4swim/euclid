{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "rootDir": "src",
    "outDir": "site/js",
    "sourceMap": false,
    "types": []
  },
  "include": [
    "src/**/*.ts"
  ]
}
